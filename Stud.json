{
  "name": "Student Performance · pieri.design",
  "dataColors": [
    "#6B58D0",
    "#9D8FE8",
    "#C4B9F7",
    "#2D2060",
    "#EF9F27",
    "#E24B4A",
    "#639922",
    "#C45A8A"
  ],
  "background": "#FFFFFF",
  "foreground": "#2D2060",
  "tableAccent": "#6B58D0",
  "visualStyles": {
    "*": {
      "*": {
        "fontFamily": [{ "value": "Segoe UI" }],
        "fontSize": [{ "value": 11 }],
        "color": [{ "value": { "solid": { "color": "#2D2060" } } }],
        "background": [{ "value": { "solid": { "color": "#FFFFFF" } } }]
      }
    },
    "card": {
      "*": {
        "background": [{ "value": { "solid": { "color": "#F5F3FF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E0D8FF" } }, "radius": 10 }],
        "calloutValue": {
          "fontSize": [{ "value": 28 }],
          "fontFamily": [{ "value": "Segoe UI" }],
          "color": [{ "value": { "solid": { "color": "#2D2060" } } }]
        },
        "label": {
          "fontSize": [{ "value": 10 }],
          "color": [{ "value": { "solid": { "color": "#8B82B5" } } }]
        }
      }
    },
    "barChart": {
      "*": {
        "background": [{ "value": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E0D8FF" } }, "radius": 10 }],
        "dataPoint": {
          "defaultColor": [{ "value": { "solid": { "color": "#6B58D0" } } }]
        },
        "categoryAxis": {
          "labelColor": [{ "value": { "solid": { "color": "#8B82B5" } } }],
          "fontSize": [{ "value": 10 }]
        },
        "valueAxis": {
          "labelColor": [{ "value": { "solid": { "color": "#8B82B5" } } }],
          "fontSize": [{ "value": 10 }],
          "gridlineColor": [{ "value": { "solid": { "color": "#EDE8FF" } } }]
        },
        "title": {
          "fontSize": [{ "value": 11 }],
          "fontFamily": [{ "value": "Segoe UI" }],
          "color": [{ "value": { "solid": { "color": "#2D2060" } } }]
        }
      }
    },
    "columnChart": {
      "*": {
        "background": [{ "value": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E0D8FF" } }, "radius": 10 }],
        "dataPoint": {
          "defaultColor": [{ "value": { "solid": { "color": "#6B58D0" } } }]
        },
        "categoryAxis": {
          "labelColor": [{ "value": { "solid": { "color": "#8B82B5" } } }],
          "fontSize": [{ "value": 10 }]
        },
        "valueAxis": {
          "labelColor": [{ "value": { "solid": { "color": "#8B82B5" } } }],
          "fontSize": [{ "value": 10 }],
          "gridlineColor": [{ "value": { "solid": { "color": "#EDE8FF" } } }]
        },
        "title": {
          "fontSize": [{ "value": 11 }],
          "fontFamily": [{ "value": "Segoe UI" }],
          "color": [{ "value": { "solid": { "color": "#2D2060" } } }]
        }
      }
    },
    "donutChart": {
      "*": {
        "background": [{ "value": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E0D8FF" } }, "radius": 10 }],
        "title": {
          "fontSize": [{ "value": 11 }],
          "color": [{ "value": { "solid": { "color": "#2D2060" } } }]
        }
      }
    },
    "scatterChart": {
      "*": {
        "background": [{ "value": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E0D8FF" } }, "radius": 10 }],
        "categoryAxis": {
          "labelColor": [{ "value": { "solid": { "color": "#8B82B5" } } }],
          "gridlineColor": [{ "value": { "solid": { "color": "#EDE8FF" } } }]
        },
        "valueAxis": {
          "labelColor": [{ "value": { "solid": { "color": "#8B82B5" } } }],
          "gridlineColor": [{ "value": { "solid": { "color": "#EDE8FF" } } }]
        }
      }
    },
    "slicer": {
      "*": {
        "background": [{ "value": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E0D8FF" } }, "radius": 10 }],
        "data": {
          "fontColor": [{ "value": { "solid": { "color": "#6B58D0" } } }],
          "fontSize": [{ "value": 10 }]
        },
        "selection": {
          "selectAllCheckboxEnabled": false
        },
        "header": {
          "fontColor": [{ "value": { "solid": { "color": "#8B82B5" } } }],
          "fontSize": [{ "value": 10 }]
        }
      }
    },
    "textbox": {
      "*": {
        "background": [{ "value": { "solid": { "color": "#FFFFFF" } } }]
      }
    },
    "shape": {
      "*": {
        "fill": [{ "value": { "solid": { "color": "#6B58D0" } } }]
      }
    }
  },
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI",
      "color": "#2D2060"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI",
      "color": "#2D2060"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "color": "#2D2060"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#8B82B5"
    }
  }
}
